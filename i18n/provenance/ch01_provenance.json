          "sources": ["13.12", "13.11", "28.6"],
          "urls": [
            "https://www.lawofone.info/s/13#12",
            "https://www.lawofone.info/s/13#11",
            "https://www.lawofone.info/s/28#6"
          ],
          "note": "Investment in exploration of many-ness; steps simultaneous and infinite; original creation not part of space/time"
